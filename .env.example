# Application environment
APP_ENV=development
LOG_LEVEL=INFO

# Backend development server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SQLITE_DATABASE_PATH=./backend/data/app-review-insights.db
MAX_UPLOAD_BYTES=10485760
MAX_REVIEW_ROWS=10000
APP_STORE_MAX_PAGES=5
APP_STORE_REQUEST_TIMEOUT_SECONDS=15

# Frontend development server
VITE_API_BASE_URL=http://localhost:8000

# Runtime semantic analysis (Phase 3). Obtain the key from https://platform.deepseek.com/.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_REVIEW_BATCH_SIZE=25
LLM_CONSOLIDATION_GROUP_SIZE=4
LLM_MAX_RETRIES=2
LLM_REQUEST_TIMEOUT_SECONDS=180
LLM_MAX_OUTPUT_TOKENS=32768
LLM_TEMPERATURE=0.2
LLM_THINKING_ENABLED=false
LLM_TRUST_ENVIRONMENT_PROXY=false
