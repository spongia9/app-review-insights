# Application environment
APP_ENV=development
LOG_LEVEL=INFO

# Backend development server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SQLITE_DATABASE_PATH=./backend/data/app-review-insights.db
MAX_UPLOAD_BYTES=10485760
MAX_REVIEW_ROWS=10000
APP_STORE_MAX_PAGES=5
APP_STORE_REQUEST_TIMEOUT_SECONDS=15

# Frontend development server
VITE_API_BASE_URL=http://localhost:8000

# Reserved for the runtime LLM provider in Phase 3. Leave blank in Phase 1.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
